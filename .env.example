# Core public site config
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel — set in dashboard; apex is canonical, www redirects via Vercel):
# NEXT_PUBLIC_SITE_URL=https://corehousepilatescy.com

NEXT_PUBLIC_STUDIO_NAME=Corehouse Pilates Studio
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=+357-00-000000

# Public social links
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/example
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/example

# In-app booking uses /book; external booking URL only if redirecting away from the site
NEXT_PUBLIC_BOOKING_URL=/book

# Optional map/embed placeholder
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=REPLACE_ME

# Supabase configuration
# Get these from your Supabase project dashboard at https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either name works; the JWT anon key is preferred for @supabase/ssr today
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required for name-based sign-in lookup and staff invite flows
# IMPORTANT: Keep this secret! Never commit or expose publicly
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# IndexNow (Bing and participating search engines)
# Must match the verification file in public/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=cf5a83b07bedf969324ef7fd3e65ee9b

# Protects /api/indexnow (Vercel Cron sends Authorization: Bearer CRON_SECRET)
# Generate a long random string; set the same value in Vercel Production env
CRON_SECRET=your-cron-secret

# Optional — authenticated Playwright booking flows (staging/dev only)
# Skipped automatically when unset. See docs/booking-staging-validation-pack.md
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
# Pre-seeded booking starting within 2 hours (Scenario B)
E2E_NEAR_CUTOFF_BOOKING_ID=
E2E_NEAR_CUTOFF_BOOKING_TITLE=
# Optional — staff booking history / day bookings regression (owner or admin)
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
# Optional known fixture (defaults shown)
# E2E_STAFF_KNOWN_CLIENT_NAME=MARIA ERAKLEOUS
# E2E_STAFF_KNOWN_BOOKING_DATE=2026-07-30
